# Dockerfile.workspace
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    mysql-client \
    python3 \
    python3-pip \
    less \
    vim \
    jq \
    procps \
  && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir mycli

WORKDIR /workdir
ENTRYPOINT ["bash"]